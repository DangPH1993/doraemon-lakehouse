# Supabase PostgreSQL connection string. Prefer Transaction/Session Pooler for hosted apps.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?sslmode=require

# Admin login. Use a long, unique password and random session secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
SESSION_SECRET=change-this-to-a-random-64-character-secret

# Optional; comma-separated origins if frontend is deployed separately.
CORS_ORIGINS=http://localhost:8000

# Pipeline defaults
PIPELINE_LOOKBACK_DAYS=14
PIPELINE_LOOKBACK_HOURS=24
MAX_FEED_ENTRIES_PER_SOURCE=250
REQUEST_TIMEOUT_SECONDS=25
TIMEZONE=Asia/Ho_Chi_Minh

# GenAI event/topic normalization (OpenAI Chat Completions API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_CLASSIFICATION_BATCH_SIZE=12
AI_CLASSIFICATION_RUN_LIMIT=72
AI_CLASSIFICATION_BACKFILL_ENABLED=false
AI_CLASSIFICATION_RETRY_COOLDOWN_HOURS=6
AI_CLASSIFICATION_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=35

# Optional Telegram linking on Render and sending during GitHub Actions pipeline.
# Create the bot with @BotFather. Store TELEGRAM_BOT_TOKEN as a GitHub Actions secret too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
# Random 32+ character secret, using only A-Z, a-z, 0-9, underscore, and hyphen.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DIGEST_MAX_ARTICLES=12

# Cloudflare Basin Catalog (R2 Data Catalog) / Apache Iceberg (optional; default OFF until bootstrap + verify).
# Warehouse and Catalog URI come from Cloudflare Basin Catalog (R2 Data Catalog); token needs catalog + R2 access.
CLOUDFLARE_LAKEHOUSE_ENABLED=false
CLOUDFLARE_LAKEHOUSE_READS=false
# Number of reusable read-only DuckDB/Basin Catalog connections per API worker (1-6; default 1).
# A single warm connection shares its materialized snapshot across the APIs used to render the first page.
CLOUDFLARE_LAKEHOUSE_READ_POOL_SIZE=1
# Snapshot cache TTL in seconds (2-60; default 30). Lower values refresh data sooner but scan Iceberg more often.
CLOUDFLARE_LAKEHOUSE_READ_SNAPSHOT_TTL_SECONDS=30
# When true, clean articles/topics/entities/bridges/FACTs write directly to Iceberg instead of PostgreSQL.
CLOUDFLARE_LAKEHOUSE_DIRECT_WRITES=false
# GitHub Actions variable only: set true after bootstrap + verify pass.
CLOUDFLARE_LAKEHOUSE_BOOTSTRAPPED=false
CLOUDFLARE_R2_WAREHOUSE=
CLOUDFLARE_R2_CATALOG_URI=
# Runtime API token with R2 + Data Catalog READ permissions only.
CLOUDFLARE_R2_READ_TOKEN=
# Server-side writer credential: required by GitHub Actions and Render for direct writes / admin catalog edits.
# Never expose this token to the browser; prefer the narrowest available Catalog + R2 permissions.
CLOUDFLARE_R2_TOKEN=
# Temporary RSS raw payloads in a dedicated Cloudflare R2 bucket (S3-compatible API).
# Use R2 S3 Access Key ID / Secret Access Key scoped to this raw bucket; these are NOT
# the Basin Catalog API Token used by CLOUDFLARE_R2_TOKEN. Keep disabled until configured.
CLOUDFLARE_R2_RAW_ENABLED=false
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_RAW_BUCKET=
CLOUDFLARE_R2_S3_ACCESS_KEY_ID=
CLOUDFLARE_R2_S3_SECRET_ACCESS_KEY=
# Optional; defaults to https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_S3_ENDPOINT=
