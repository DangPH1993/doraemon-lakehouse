# Neon PostgreSQL: use the POOLED URL for regular queries (hostname contains -pooler).
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
# Neon DIRECT URL (hostname without -pooler) for session-level advisory locks and bootstrap/migrations.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<database>?sslmode=require

# Admin login. Use a long, unique password and random session secret.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-random-password
SESSION_SECRET=change-this-to-a-random-64-character-secret

# Optional; comma-separated origins if frontend is deployed separately.
CORS_ORIGINS=http://localhost:8000

# Pipeline defaults
PIPELINE_LOOKBACK_DAYS=14
PIPELINE_LOOKBACK_HOURS=24
MAX_FEED_ENTRIES_PER_SOURCE=250
REQUEST_TIMEOUT_SECONDS=25
TIMEZONE=Asia/Ho_Chi_Minh

# GenAI event/topic normalization (OpenAI Chat Completions API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_CLASSIFICATION_BATCH_SIZE=12
AI_CLASSIFICATION_RUN_LIMIT=72
AI_CLASSIFICATION_BACKFILL_ENABLED=false
AI_CLASSIFICATION_RETRY_COOLDOWN_HOURS=6
AI_CLASSIFICATION_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_SECONDS=35

# Optional Telegram linking on Render and sending during GitHub Actions pipeline.
# Create the bot with @BotFather. Store TELEGRAM_BOT_TOKEN as a GitHub Actions secret too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
# Random 32+ character secret, using only A-Z, a-z, 0-9, underscore, and hyphen.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DIGEST_MAX_ARTICLES=12
